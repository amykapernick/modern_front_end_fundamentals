{
  "name": "modern-front-end-fun-damentals",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --config ./config/astro.config.mjs",
    "start": "npm run dev",
    "build": "astro build",
    "lint": "eslint -c ./config/eslint.config.mjs --fix",
    "ts": "tsc",
    "clean": "rm -rf node_modules .asto dist",
    "test:update": "npx playwright test --update-snapshots"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "^9.9.0"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "^9.9.0"
    }
  },
  "dependencies": {
    "@astrojs/react": "^4.2.7",
    "@axe-core/playwright": "^4.10.1",
    "astro": "^5.7.11",
    "dotenv": "^17.2.3",
    "file-system": "^2.2.2",
    "pa11y": "^9.0.1",
    "path": "^0.12.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.0.10",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.26.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.31.0",
