{
  "name": "modern-front-end-fun-damentals",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --config ./config/astro.config.mjs",
    "start": "npm run dev",
    "build": "astro build",
    "lint": "eslint -c ./config/eslint.config.mjs --fix",
    "ts": "tsc",
    "clean": "rm -rf node_modules .asto dist",
    "test:update": "npx playwright test --update-snapshots"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "^9.9.0"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "^9.9.0"
    }
  },
  "dependencies": {
    "@astrojs/react": "^3.6.2",
    "@axe-core/playwright": "^4.10.0",
    "astro": "^4.14.5",
    "dotenv": "^16.0.3",
    "file-system": "^2.2.2",
    "pa11y": "^8.0.0",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@types/node": "^22.5.0",
    "astro-eslint-parser": "^1.0.2",
    "eslint": "^9.9.0",
    "eslint-plugin-astro": "^1.2.3",
    "eslint-plugin-import": "^2.27.5",
