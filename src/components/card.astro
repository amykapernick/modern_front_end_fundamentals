---
const { slug, name, category, tags = [], status } = Astro.props
---

<style>
	.card {
		background: rgba($purple, 0.4);
		padding: 10px;
		height: 100%;
		border-radius: 10px;
		position: relative;
	}  

	.docs, .exercises {
		background: $purple;
		color: $white;
		padding: 0.2em;
		border-radius: 5px;
		line-height: 1;
		display: inline-block;
		text-decoration: none;

		&:hover {
			background: $white;
			color: $purple;
		}
	}

	.name {
		margin: 0.5em 0 0.2em;
	}

	:global(body:not(.css_mode)) {
		@supports(grid-template-areas: '.') {
			& .card {
				display: grid;
				grid-column-gap: 5px;
				grid-row-gap: 10px;
				grid-template-rows: 1fr auto;
				grid-template-columns: 1fr 1fr;
				grid-template-areas:
					'title title'
					'docs exercises';
				max-width: unset;
			}

			& .exercises {
				justify-self: end;
				grid-area: exercises;
			}

			& .docs {
				justify-self: start;
				grid-area: docs;
			}

			& .name {
				grid-area: title;
				margin: 0;
			}
		}
	}

	
</style>

<div class="card" data-devTools="card">
	<h3 data-devTools="name" class="name">
		{name}
	</h3>	
	<a href={`/${slug}/docs`} class="docs">
		🔗 Docs
	</a>
	<a href={`/${slug}/exercises`} class="exercises">
		🔗 Exercises	
	</a>
</div>