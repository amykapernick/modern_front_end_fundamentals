---
import Card from "@components/card"

const { sections } = Astro.props
---

<style>
	.sections {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.item {
		padding: 0;
	}

	:global(body:not(.css_mode)) {
		& .sections {
			gap: 10px;
			display: flex;
			flex-wrap: wrap;
		}

		& .item {
			max-width: 300px;
		}

		@supports(grid-template-areas: '.') {
			& .sections {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
				grid-gap: 20px;
				margin: 0;
			}
		}
	}
</style>

<ul class="sections" data-devTools="sections">
	{sections
		.map((props, i) => (
		<li class="item" data-devTools="item">
			<Card {...props} name={`${i + 1}.0 - ${props.name}`} />
		</li>
	))}
</ul>