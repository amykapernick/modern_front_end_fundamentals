---
import Logo from '@img/fundamentals.svg?url'

const menuItems = [
  {
	label: 'Home',
	link: '/',
  },
  {
	label: 'Sets',
	items: [
		{
			label: 'Assembled',
			link: '/assembled'
		},
		{
			label: 'Wishlist',
			link: '/wishlist'
		},
		{
			label: 'Unreleased',
			link: '/unreleased'
		},
		{
			label: 'Stored',
			link: '/stored'
		},
		{
			label: 'All',
			link: '/sets'
		}
	]
  },
  {
	label: 'Lego Store',
	link: 'https://lego.com.au/'
  },
  {
	label: 'About',
	link: '/about'
  },
  {
	label: 'HTML Elements',
	link: '/html'
  },
  {
	label: 'Add Set',
	link: '/add'
  }
]; 
---

<style>
	@import '@mixins';

	header {

		@include container_spacing;

		font-size: 1.2em;
		font-weight: 700;
		display: flex;
		flex-wrap: wrap;
		padding: 10px;
	}
 
	.title {
		display: block;
		font-size: 5em;
		text-decoration: none;
		width: 100%;
		text-align: center;
		line-height: 1;

		& img {
			height: 1em;
			width: auto;
		}
	}

	nav {
		flex-grow: 1;
	}

	.menu {
		padding: 10px 0;

		& li {
			position: relative;
			padding: 0;
		}

		& a, & button {
			display: flex;
			align-items: center;
			height: 100%;
			padding: 10px;
			color: inherit;
			font-size: inherit;
			font-weight: inherit;
		}
	}

	:global(body:not(.css_mode)) {
		& header {
			justify-content: center;
			align-items: center;
		}

		& .menu {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			margin: 0;

			& li {
				margin: 0;
			}
		}
	}

	.sub {
		display: none;
		position: absolute;
		z-index: 50;
		top: 100%;
		left: 0;
		margin: 0;
		padding: 0;
		background: var(--background);
		box-shadow: 0 0 10px rgba($neutral, 0.2);
		font-size: 0.8em;
		list-style: none;

		&:global(.open) {
			display: block;
		}

		& li {
			margin: 0;
			padding: 0;
			
		}

		& a, & button {
			padding: 10px;
			background: var(--background);
			color: inherit;
			font-size: inherit;
			font-weight: inherit;
		}
	}

	button {

		@include button_text;
	}

	@media(min-width: 40em) {
		.header {
			justify-content: space-between;
			flex-wrap: nowrap;
			padding: 20px;
		}

		.title {
			width: auto;
		}

		.menu {
			margin-left: 30px;
		}

		:global(body:not(.css_mode)) {
			& .menu {
				justify-content: flex-end;
			}
		}
	}

	@media(max-width: 50em) {
		.sub {
			width: max-content;
		}
	}
</style>

<script>
	const menuSections = document.querySelectorAll('.menu_section');

	menuSections.forEach(section => {
		section.addEventListener('click', () => {
			section.nextElementSibling?.classList.toggle('open');
		})
	})
</script>

<header data-testid="header" class="header" data-devTools="header" id="header">
	<a href="/" class="title" id="a">
		<img src={Logo} />
		<span class="sr-only">Modern Front End Fun-damentals</span>
	</a>
	<nav>
		<ul class="menu" data-devTools="menu">
			{menuItems.map(({label, link, items}) => (
				<li class="menu_item" data-devTools="menu_item">
					{items ? 
						<>
							<button class="menu_section">{label}</button>
							<ul class="sub">
								{
									items.map(item => (
										<li>
											<a 
												href={item.link}
												target={item.link.startsWith('http') ? '_blank' : '_self'}
											>
												{item.label}
											</a>
										</li>
									))
								}
							</ul>
						</> : 
						<a 
							href={link}
							target={link.startsWith('http') ? '_blank' : '_self'}
						>
							{label}
						</a>
					}	
				</li>
			))}
		</ul>
	</nav>
</header>
