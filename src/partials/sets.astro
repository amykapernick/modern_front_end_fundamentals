---
import Card from "@components/card"
import { Image, Picture } from "astro:assets"

const { sets } = Astro.props
---

<style>
	.sets {
		margin: -20px;
		padding: 10px;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
	}

	.item {
		margin: 10px;
		padding: 0;
		max-width: 300px;
	}

	

	@supports(grid-template-areas: '.') {
		.sets {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
			grid-gap: 20px;
			margin: 0;
		}

		.item {
			margin: 0;
		}
	}
</style>

<ul class="sets" data-devTools="sets">
	{sets
		.sort((a, b) => a.id - b.id)
		.map((props) => (
		<li class="item">
			<Card {...props} />
		</li>
	))}
</ul>