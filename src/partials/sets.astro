---
import Card from "@components/card"

const { sets } = Astro.props
---

<style>
	.sets {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.item {
		padding: 0;
	}

	:global(body:not(.css_mode)) {
		& .sets {
			gap: 10px;
			display: flex;
			flex-wrap: wrap;
		}

		& .item {
			max-width: 300px;
		}

		@supports(grid-template-areas: '.') {
			& .sets {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
				grid-gap: 20px;
				margin: 0;
			}
		}
	}
</style>

<ul class="sets" data-devTools="sets">
	{sets
		.sort((a, b) => a.id - b.id)
		.map((props) => (
		<li class="item" data-devTools="item">
			<Card {...props} />
		</li>
	))}
</ul>