---
import Layout from '@layouts/default';
import allSets from '@data/sets.json';
import Sets from '@partials/sets';

const content = {
	title: `All Sets`,
	description: `All lego sets`
}
const sets = Object.entries(allSets)
	.map(([id, props]) => ({
		id,
		...props
	}))
	.sort((a, b) => parseInt(a.id) - parseInt(b.id))

const categories: string[] = sets
	.map(({status}) => status)
	.filter((status, index, self) => self.indexOf(status) === index)

---

<style>
	.categories {
		list-style: none;
		padding: 0;
		margin: 0 0 20px;
	}

	.category {
		display: block;
		padding: 0.2em 0.8em;
		font-size: 1.2em;
		color: inherit;
		font-weight: 600;
		text-decoration: none;

		&:hover {
			background-color: var(--purple_bright);
			color: var(--white);
			border-radius: 3px;
		}
	}

	:global(body:not(.css_mode)) {
		& .categories {
			display: flex;
			flex-wrap: wrap;
		}
	}
</style>

<Layout content={content}>
	<h1>All Sets</h1>
	<ul class="categories" data-devTools="categories">
		{categories.map((category) => (
			<li>
				<a class="category" href={`/sets/${category.toLowerCase().replace(/\s/g, '-')}`}>{category}</a>
			</li>
		))}
	</ul>
	<Sets sets={sets} />
</Layout>