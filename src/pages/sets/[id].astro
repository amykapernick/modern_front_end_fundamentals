---
import Layout from '@layouts/default';
import sets from '@data/sets.json';

export const prerender = true;

export function getStaticPaths() {
	return Object.entries(sets)
		.map(([id, props]) => ({
			params: {
				id: id
			},
			props: props
		}))
}

const { id } = Astro.params;
const { name, category, tags, pieces } = Astro.props;
const content = {
	title: `${id} - ${name}`,
	description: `LEGO set number ${id}, titled ${name} with ${pieces} pieces.`,
}

---

<style>
	article {
		overflow: hidden;
		clear: both;
	}

	header {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-gap: 10px 20px;
		margin-bottom: 40px;
		clear: both;
	}

	h1 {
		margin: 0;
		line-height: 1;
	}

	.id {
		font-size: 5em;
		grid-row: 1 / span 2;
		font-family: $font_heading;
		color: $navy;
		font-weight: 900;
		line-height: 1;

		display: inline-block;
		width: auto;
		height: 1em;
		background-color: $purple;
		border-radius: 3px 4px 4px 3px;
		border-left: 1px solid $purple;
		margin-left: 0.5em;
		position: relative;
		color: white;
		line-height: 1em;
		padding: 0 0.4em 0 0.4em;

		&:before {
			content: "";
			position: absolute;
			display: block;
			left: -0.5em;
			width: 0;
			height: 0;
			border-top: 0.5em solid transparent;
			border-bottom: 0.5em solid transparent;
			border-right: 0.5em solid $purple;
		}

		&:after {
			content: "";
			background-color: $background;
			border-radius: 50%;
			width: 0.2em;
			height: 0.2em;
			display: block;
			position: absolute;
			left: -0.3em;
			top: 0.4em;
		}
	}

	.pieces {
		font-size: 1.5em;
		color: $purple_bright;
		font-weight: 700;
		line-height: 1;
	}

	.img {
		float: right;
		margin-left: 20px;
		width: 400px;
		height: 400px;
		
		& img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			object-position: center top;
		}
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		padding: 0;
		list-style: none;
		margin: -5px;
		font-size: 2em;

		& li {
			background: rgba($purple, 0.2);
			padding: 0.2em 0.5em;
			border-radius: 5px;
			margin: 5px;
			line-height: 1;
		}
	}

	form {
		max-width: 500px;

		& button {
			padding: 0.2em 0.5em;
			font-size: 1em;
			margin-top: 20px;
		}
	}
</style>

<Layout content={content}>
	<article>
		<header>
			<h1>{name}</h1>
			<span class="id">{id}</span>
			<span class="pieces">🧱 {pieces} pieces</span>
		</header>
		<div class="img">
			<img src={`/img/sets/${id}.jpg`} />
		</div>
		<ul class="tags">
			{[category, ...tags]
				.filter((tag, i, arr) => arr.indexOf(tag) === i)
				.map(tag => (
				<li>{tag}</li>
			))}
		</ul>
		<section>
			<h2>Are LEGO® sets for adults?</h2>
			<p>You bet… Spend quality time with premium LEGO® sets designed specifically for adults. From wonders of the world to movie magic, intrepid space exploration to pop culture icons, luxury cars to architectural masterpieces, there’s a LEGO set waiting for you. So unplug, unbox and unwind. This is your zone.</p>
		</section>
		<section>
			<h2>Discover LEGO® sets for adults, whatever the passion!</h2>
			<p>Premium, display-worthy LEGO® sets. Carefully curated and designed specifically for grown-up hands.</p>
			<p>In a world of distractions, LEGO Sets for Adults offer a focused, hands-on, mindful activity. A creative recharge. A zone of zen. A place to find your flow.</p>
		</section>
	</article>
	
	
</Layout>