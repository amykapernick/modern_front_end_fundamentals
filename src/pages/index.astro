---
import Layout from '@layouts/default';
import allSets from '@data/sets.json'
import Sets from '@partials/sets';

let statuses = {}

Object.entries(allSets).forEach(([id, props]) => {
	const status = props.status.toLowerCase().replace(/\s/g, '-')
	if(!statuses[status]) {
		statuses[status] = {
			status: props.status,
			sets: []
		}
	}

	statuses[status].sets.push({
		id,
		...props
	})
})

---

<style>
	.statuses {
		overflow-x: auto;
		gap: 10px;
	}

	:global(body:not(.css_mode)) {
		& .statuses {
			display: flex;
		}
	}
</style>

<Layout>
	<h1>Modern Fun-damentals</h1>
	<div class="statuses" data-devTools="statuses">
		{Object.values(statuses).map(({status, sets}) => (
		<section data-status={status.toLowerCase()} data-devTools="status" class="status">
			<h2>{status}</h2>
			<Sets sets={sets} />
		</section>
	))}
	</div>
</Layout>