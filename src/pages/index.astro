---
import Layout from '@layouts/default';
import sections from '@data/sections.json'
import Sections from '@partials/sections';

---

<style>
	.statuses {
		overflow-x: auto;
		gap: 10px;
	}

	:global(body:not(.css_mode)) {
		& .statuses {
			display: flex;
		}
	}
</style>

<Layout>
	<h1>Modern Fun-damentals</h1>
	<Sections sections={sections} />
</Layout>