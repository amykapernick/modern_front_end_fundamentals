---
import Layout from '@layouts/default';
import allSets from '@data/sets.json';
import Sets from '@partials/sets';

export const prerender = true;

export function getStaticPaths() {
	let statuses = {}

	Object.entries(allSets).forEach(([id, props]) => {
		const status = props.status.toLowerCase().replace(/\s/g, '-')
		if(!statuses[status]) {
			statuses[status] = {
				status: props.status,
				sets: []
			}
		}

		statuses[status].sets.push({
			id,
			...props
		})
	})

	console.log({allSets, statuses})

	return Object.entries(statuses)
		.map(([status, props]) => ({
			params: {
				status
			},
			props
		}))
}

const { sets, status } = Astro.props
const content = {
	title: `${status} Sets`,
	description: `All sets with the status ${status}, ${sets.length} sets`
}

---

<Layout content={content}>
	<h1>{status} Sets</h1>
	<Sets sets={sets} />
</Layout>