---
import Layout from '@layouts/default';
import AboutContent from '@data/about.html'

const content = {
	title: 'About Lego',
	description: 'Information about lego',
};

---

<style is:global>
	.embed_page {
		& nav {
			display: flex;
			flex-wrap: wrap;
			margin: -10px;
			padding: 10px;
			justify-content: flex-end;
			font-weight: 600;

			& a {
				display: block;
				margin: 10px;
				text-decoration: none;
				color: inherit;

				&:hover {
					text-decoration: underline;
				}
			}
		}

		& img, & video {
			display: block;
			margin: 1em auto;
		}

		& img:not([width]), & video {
			max-width: 100%;
			height: auto;
			max-height: 80vh;
		}

		& figure {
			border: 2px solid var(--blue);
			padding: 10px;

			& img, & video {
				margin: 0 auto;
			}

			& figcaption {
				margin-top: 1em;
				font-style: italic;
				color: var(--navy);
				text-align: center;
			}
		}

		& form {
			padding: 10px;
			max-width: 800px;
			margin: 0 auto;
		}

		& label, & legend {
			display: block;
			margin: 1em 0 0.2em;
			font-weight: 700;
		}

		& input, & select, & textarea {
			display: block;
			width: 100%;
			padding: 10px 15px;
			border: 2px solid currentColor;
		}

		& input {
			&:invalid {
				border-color: #e53f51;
			}

			&:valid {
				border-color: #168119;
			}

			&[type="range"] {
				margin: 0 auto;
				padding: 0;
				width: calc(100% - (100% / var(--opts)));
				border: none;
				background: none;
				accent-color: var(--purple_bright);
			}

			&  + datalist {
				display: grid;
				grid-template-columns: 50px repeat(var(--opts),1fr 2em);
				width: 100%;
				font-size: .6em;
				white-space: break-spaces;
				overflow-wrap: break-word;

				& option {
					display: block;
					grid-column: span 3;
					width: 100%;
					max-width: 100%;
					margin: 10px 0 0;
					padding: 0;
					text-align: center;
					white-space: pre-wrap;
					grid-column-end: span 3;

					&:nth-child(2n) {
						grid-row-start: 2;
					}

					&:nth-child(1) {
						grid-column-start: 1;
					}

					&:nth-child(2) {
						grid-column-start: 3;
					}

					&:nth-child(3) {
						grid-column-start: 5;
					}

					&:nth-child(4) {
						grid-column-start: 7;
					}

					&:nth-child(5) {
						grid-column-start: 9;
					}

					&:nth-child(6) {
						grid-column-start: 11;
					}

					&:nth-child(7) {
						grid-column: 13/span 3
					}

					&:nth-child(8) {
						grid-column: 15/span 3
					}

					&:nth-child(9) {
						grid-column: 17/span 3
					}

					&:nth-child(10) {
						grid-column: 19/span 3
					}
				}
			}

		}

		& form {
			& div {
				&:has(input[type="range"] + datalist option:nth-child(1)) {
					--opts: 1;
				}

				&:has(input[type="range"] + datalist option:nth-child(2)) {
					--opts: 2;
				}

				&:has(input[type="range"] + datalist option:nth-child(3)) {
					--opts: 3;
				}

				&:has(input[type="range"] + datalist option:nth-child(4)) {
					--opts: 4;
				}

				&:has(input[type="range"] + datalist option:nth-child(5)) {
					--opts: 5;
				}

				&:has(input[type="range"] + datalist option:nth-child(6)) {
					--opts: 6;
				}

				&:has(input[type="range"] + datalist option:nth-child(7)) {
					--opts: 7;
				}

				&:has(input[type="range"] + datalist option:nth-child(8)) {
					--opts: 8;
				}

				&:has(input[type="range"] + datalist option:nth-child(9)) {
					--opts: 9;
				}

				&:has(input[type="range"] + datalist option:nth-child(10)) {
					--opts: 10;
				}
			}
		}

		& map area {
			background: pink;
		}

		& footer {
			text-align: center;
		}
	}
</style>

<Layout content={content}>
	<h1>About</h1>
	<div class="embed_page">
		<AboutContent />
	</div>
</Layout>